generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tip {
  id             String   @id @default(cuid())
  tipper_address String   @db.VarChar(42)
  repo_id        String
  token          String   @db.VarChar(42)
  amount         Decimal  @db.Decimal(78, 0)
  fee_amount     Decimal  @db.Decimal(78, 0)
  timestamp      DateTime
  tx_hash        String
  block_number   BigInt

  @@index([repo_id])
  @@index([tipper_address])
  @@index([token])
  @@index([timestamp])
}

model Claim {
  id             String   @id @default(cuid())
  repo_id        String
  payout_address String   @db.VarChar(42)
  token          String   @db.VarChar(42)
  amount         Decimal  @db.Decimal(78, 0)
  timestamp      DateTime
  tx_hash        String
  block_number   BigInt

  @@index([repo_id])
  @@index([payout_address])
  @@index([token])
  @@index([timestamp])
}

model DisplayName {
  tipper_address String @id @db.VarChar(42)
  display_name   String @db.VarChar(64)
  updated_at     DateTime @updatedAt
}

model IndexerState {
  id          String @id @default("singleton")
  last_block  BigInt
  updated_at  DateTime @updatedAt
}

model Repo {
  repo_id        String   @id
  payout_address String   @db.VarChar(42)
  registered_at  DateTime
  updated_at     DateTime @updatedAt
  hidden         Boolean  @default(false)
  icon           String?
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  githubId      String?   @unique
  login         String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  wallets       UserWallet[]
  notifications Notification[]
  notificationSubscriptions NotificationSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model UserWallet {
  id                 String   @id @default(cuid())
  userId             String
  address            String   @unique @db.VarChar(42)
  signature          String?  @db.Text
  linkedAt           DateTime @default(now())
  walletType         String   @default("eoa") @db.VarChar(16)
  isPrimary          Boolean  @default(false)
  subAccountAddress  String?  @db.VarChar(42)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model NotificationSubscription {
  id              String   @id @default(cuid())
  userId          String
  endpoint        String   @db.Text
  p256Key         String   @db.Text
  auth            String   @db.Text
  types           Json     @default("[\"tip_received\",\"claim_available\",\"tip_sent\",\"claim_submitted\"]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, endpoint])
  @@index([userId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   @db.VarChar(32)
  title       String   @db.Text
  body        String   @db.Text
  read        Boolean  @default(false)
  txHash      String?  @db.VarChar(66)
  status      String   @default("pending") @db.VarChar(16)
  ref         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([status])
  @@index([ref])
}
