generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tip {
  id             String   @id @default(cuid())
  tipper_address String   @db.VarChar(42)
  repo_id        String
  token          String   @db.VarChar(42)
  amount         Decimal  @db.Decimal(78, 0)
  fee_amount     Decimal  @db.Decimal(78, 0)
  timestamp      DateTime
  tx_hash        String
  block_number   BigInt

  @@index([repo_id])
  @@index([tipper_address])
  @@index([token])
  @@index([timestamp])
}

model Claim {
  id             String   @id @default(cuid())
  repo_id        String
  payout_address String   @db.VarChar(42)
  token          String   @db.VarChar(42)
  amount         Decimal  @db.Decimal(78, 0)
  timestamp      DateTime
  tx_hash        String
  block_number   BigInt

  @@index([repo_id])
  @@index([payout_address])
  @@index([token])
  @@index([timestamp])
}

// App-submitted transactions (write-ahead log). Every send/tip/claim/register
// initiated through our UI is recorded here at submit time, so wallet history
// shows it instantly — including smart-wallet ETH movements that no free
// explorer API can see (internal traces aren't covered on Base).
model WalletTx {
  id           String   @id @default(cuid())
  wallet       String   @db.VarChar(42)
  kind         String   @db.VarChar(16)
  repo_id      String?
  token        String?  @db.VarChar(42)
  amount       String?
  to_address   String?  @db.VarChar(42)
  user_op_hash String?  @unique
  tx_hash      String?  @unique
  status       String   @default("pending") @db.VarChar(16)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([wallet])
  @@index([tx_hash])
  @@index([user_op_hash])
}

model DisplayName {
  tipper_address String   @id @db.VarChar(42)
  display_name   String   @db.VarChar(64)
  updated_at     DateTime @updatedAt
}

model IndexerState {
  id         String   @id @default("singleton")
  last_block BigInt
  updated_at DateTime @updatedAt
}

model Repo {
  repo_id              String    @id
  payout_address       String    @db.VarChar(42)
  registered_at        DateTime
  updated_at           DateTime  @updatedAt
  summary              String?   @db.Text
  summary_generated_at DateTime?
  links                String?   @db.Text
  hidden               Boolean   @default(false)
  icon                 String?
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  passwordHash    String?
  resetToken      String?
  resetTokenExpiry DateTime?
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?
  pfp             String?  @db.Text
  header          String?  @db.Text
  image           String?
  githubId        String?   @unique
  login           String?   @unique
  onboardingComplete Boolean @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  wallets       UserWallet[]
  notifications Notification[]
  notificationSubscriptions NotificationSubscription[]
  sponsoredTxs SponsoredTx[]
  profile       DeveloperProfile?
  policy        UserPolicy?
}

model DeveloperProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  bio          String?  @db.Text
  website      String?  @db.VarChar(255)
  twitter      String?  @db.VarChar(255)
  discord      String?  @db.VarChar(255)
  telegram     String?  @db.VarChar(255)
  farcaster    String?  @db.VarChar(255)
  github       String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model UserWallet {
  id                 String   @id @default(cuid())
  userId             String
  address            String   @unique @db.VarChar(42)
  signature          String?  @db.Text
  linkedAt           DateTime @default(now())
  walletType         String   @default("eoa") @db.VarChar(16)
  isPrimary          Boolean  @default(false)
  subAccountAddress  String?  @db.VarChar(42)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model UserPolicy {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  walletAddress              String?  @db.VarChar(42)
  pauseAll                   Boolean  @default(false)
  allowArbitraryCalls        Boolean  @default(true)
  dailyLimitUsd              Decimal  @db.Decimal(12, 2) @default(1000)
  dailyLimitEnabled          Boolean  @default(true)
  perTxLimitUsd              Decimal  @db.Decimal(12, 2) @default(500)
  perTxLimitEnabled          Boolean  @default(true)
  permittedRecipientsEnabled Boolean  @default(false)
  permittedRecipients        Json     @default("[]")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(cuid())
  address   String   @unique @db.VarChar(42)
  role      String   @default("admin")
  addedBy   String?  @db.VarChar(42)
  createdAt DateTime @default(now())
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminAddr String   @db.VarChar(42)
  action    String
  params    Json
  txHash    String?
  timestamp DateTime @default(now())

  @@index([adminAddr])
  @@index([action])
  @@index([timestamp])
}

model NotificationSubscription {
  id              String   @id @default(cuid())
  userId          String
  endpoint        String   @db.Text
  p256Key         String   @db.Text
  auth            String   @db.Text
  types           Json     @default("[\"tip_received\",\"claim_available\",\"tip_sent\",\"claim_submitted\"]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, endpoint])
  @@index([userId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   @db.VarChar(32)
  title       String   @db.Text
  body        String   @db.Text
  read        Boolean  @default(false)
  txHash      String?  @db.VarChar(66)
  status      String   @default("pending") @db.VarChar(16)
  ref         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([status])
  @@index([ref])
}

// Gas sponsorship ledger (CDP paymaster). One row per proxied user
// operation: doubles as the daily-cap counter (count today's rows),
// the admin spend view (sum gasUsd), and the reconciliation target
// (confirm flow backfills actual gasWei/gasUsd from the receipt).
model SponsoredTx {
  id           String   @id @default(cuid())
  userId       String
  userOpHash   String?  @unique
  txHash       String?  @unique
  kind         String   @db.VarChar(16)
  gasWei       String?
  gasUsd       Decimal? @db.Decimal(12, 2)
  status       String   @default("pending") @db.VarChar(16)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
